# Choose which profile to run: local or prod.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081
LOGGING_LEVEL_ROOT=DEBUG
# Local profile database settings. These are used only when
# SPRING_PROFILES_ACTIVE=local.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/your_database
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=your_local_db_username
SPRING_DATASOURCE_PASSWORD=your_local_db_password
SPRING_FLYWAY_ENABLED=false
# Prod profile database settings. These are used only when
# SPRING_PROFILES_ACTIVE=prod.
PROD_SPRING_DATASOURCE_URL=jdbc:postgresql://your-prod-host/your_database?sslmode=require
PROD_SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
PROD_SPRING_DATASOURCE_USERNAME=your_prod_db_username
PROD_SPRING_DATASOURCE_PASSWORD=your_prod_db_password
# Shared service credentials.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─────────────────────────────────────────────────────────────────
# ALTERNATIVE LOCAL PROFILE CONFIGURATION (commented out for reference)
# ─────────────────────────────────────────────────────────────────
# SPRING_PROFILES_ACTIVE=local
# SERVER_PORT=8081
# LOGGING_LEVEL_ROOT=DEBUG
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/your_database
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
# SPRING_DATASOURCE_USERNAME=your_local_db_username
# SPRING_DATASOURCE_PASSWORD=your_local_db_password
# SPRING_FLYWAY_ENABLED=false
